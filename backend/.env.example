# Correo saliente SMTP. Completa estos valores para que la recuperación llegue.
# Ejemplo con un proveedor SMTP: usa una contraseña de aplicación, no tu clave personal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion
SMTP_FROM=VolunMatch <tu-correo@gmail.com>
APP_URL=http://localhost:5173
